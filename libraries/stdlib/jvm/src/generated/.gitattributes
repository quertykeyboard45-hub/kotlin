## 3. Firmware Throwback Structure (M5Stack UHF Feed UI)
This C++/Arduino-style firmware loop handles the vintage pneumatic control inputs alongside modern UHF feed telemetry displayed on the M5Stack screen.
```cpp
#include <M5Unified.h>

const int PNEUMATIC_ADC_PIN = 36; // Analog pin for pneumatic pressure transducer (<right=tight&left=loose>)
int sensorValue = 0;

void setup() {
  auto cfg = M5.config();
  M5.begin(cfg);
  M5.Display.begin();
  M5.Display.setTextSize(2);
  M5.Display.fillScreen(BLACK);
  
  pinMode(PNEUMATIC_ADC_PIN, INPUT);
  
  M5.Display.setCursor(10, 10);
  M5.Display.setTextColor(GREEN, BLACK);
  M5.Display.print("GE 1950s UHF UI");
}

void loop() {
  M5.update();
  
  // Read pneumatic tension state (<right=tight / left=loose>)
  sensorValue = analogRead(PNEUMATIC_ADC_PIN);
  
  // Update Display UI
  M5.Display.setCursor(10, 50);
  M5.Display.print("Pneumatic P: ");
  M5.Display.print(sensorValue);
  M5.Display.print("   ");

  M5.Display.setCursor(10, 90);
  M5.Display.print("UHF Feed: ACTIVE");
  
  delay(100);
}

```
